---
import Base from '../layouts/Base.astro'
import { allProfiles, initials } from '../lib/profiles'
import { uz } from '../texts/uz'

const profiles = (await allProfiles()).filter((profile) => profile.data.listed)
---

<Base title={uz.siteName}>
  <main class="page">
    <h1>{uz.siteName}</h1>
    <p class="lead">{uz.siteDescription}</p>
    <h2 class="visually-hidden">{uz.indexTitle}</h2>
    <ul>
      {
        profiles.map((profile) => (
          <li>
            <a href={`/${profile.id}`}>
              <span class="initials" aria-hidden="true">
                {initials(profile.data.name)}
              </span>
              <span>
                <strong>{profile.data.name}</strong>
                {profile.data.bio && <small>{profile.data.bio}</small>}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  h1 {
    margin: 0;
    font-size: 28px;
  }
  .lead {
    margin: 4px 0 24px;
    color: var(--muted);
  }
  ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
  }
  .initials {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 700;
  }
  strong,
  small {
    display: block;
  }
  small {
    color: var(--muted);
    font-size: 14px;
  }
</style>
